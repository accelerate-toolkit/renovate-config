{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared dependency update defaults for Leverage Works and downstream organizations.",
  "extends": [
    "config:recommended",
    "github>accelerate-toolkit/renovate-config:groups(accelerate-toolkit)"
  ],
  "semanticCommits": "enabled",
  "automerge": true,
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": {
    "enabled": true,
    "labels": [
      "renovate-dependency-dashboard"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/build/**",
    "**/apm_modules/**",
    "**/.agents/**",
    "**/.codex/**"
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false
}
